{
  "hooks": {
    "PostToolUse": {
      "hooks": [
        {
          "type": "command",
          "command": "python tools/review_loop/register.py --from-hook",
          "timeout": 15
        }
      ]
    },
    "Stop": {
      "hooks": [
        {
          "type": "command",
          "command": "python tools/review_loop/register.py --from-hook",
          "timeout": 15
        }
      ]
    }
  }
}
