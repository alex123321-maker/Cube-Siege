[configuration]

entry_symbol = "cube_siege_library_init"
compatibility_minimum = "4.1"

[libraries]

windows.debug.x86_64 = "res://bin/libcube_siege.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libcube_siege.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libcube_siege.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libcube_siege.linux.template_release.x86_64.so"
